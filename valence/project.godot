; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Valence"
config/description="Read-only 3D map of a codebase: systems as atoms, classes as nucleons."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
run/flush_stdout_on_print=true
config/icon="res://images/icon.png"
boot_splash/bg_color=Color(0.992, 0.988, 0.976, 1)
boot_splash/show_image=true
boot_splash/image="res://images/logo.png"
boot_splash/stretch_mode=1
boot_splash/fullsize=true
boot_splash/use_filter=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Valence"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
